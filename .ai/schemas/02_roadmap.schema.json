{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/02_roadmap.schema.json",
  "title": "Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "current_phase",
    "active_objective",
    "tasks"
  ],
  "properties": {
    "kind": {
      "const": "roadmap"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "current_phase": {
      "type": "string",
      "enum": [
        "foundation",
        "planning",
        "implementation",
        "stabilization",
        "maintenance",
        "archive"
      ]
    },
    "active_objective": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "depends_on",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in_progress",
              "blocked",
              "completed",
              "done",
              "cancelled"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TASK-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "last_review_utc": {
      "type": "string",
      "format": "date-time"
    },
    "last_pruned_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
