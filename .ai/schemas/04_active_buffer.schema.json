{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/04_active_buffer.schema.json",
  "title": "Active Buffer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "session",
    "focus",
    "working_set",
    "next_actions",
    "risks",
    "blockers",
    "resurrection_packet"
  ],
  "properties": {
    "kind": {
      "const": "active_buffer"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "started_at_utc",
        "operator_goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "operator_goal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_problem",
        "current_slice"
      ],
      "properties": {
        "current_problem": {
          "type": "string",
          "minLength": 1
        },
        "current_slice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "working_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_in_play"
      ],
      "properties": {
        "files_in_play": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recent_decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "title",
          "type",
          "success_signal"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "edit",
              "verify",
              "decide",
              "test",
              "document",
              "commit",
              "investigate"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "success_signal": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "mitigation",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RISK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "monitoring",
              "mitigated",
              "blocked"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "unblock_condition",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BLK-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "unblock_condition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          }
        }
      }
    },
    "resurrection_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_from",
        "intended_first_move",
        "rationale_summary",
        "files_likely_next"
      ],
      "properties": {
        "resume_from": {
          "type": "string",
          "minLength": 1
        },
        "intended_first_move": {
          "type": "string",
          "minLength": 1
        },
        "rationale_summary": {
          "type": "string",
          "minLength": 1
        },
        "files_likely_next": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
