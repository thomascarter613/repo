{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/03_logic_map.schema.json",
  "title": "Logic Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "system_model",
    "components",
    "flows",
    "invariants"
  ],
  "properties": {
    "kind": {
      "const": "logic_map"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "system_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "source_of_truth",
        "reducer",
        "compiled_artifact"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1
        },
        "reducer": {
          "type": "string",
          "minLength": 1
        },
        "compiled_artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "location",
          "responsibility"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger",
          "path",
          "outcome"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "contract"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "script",
              "workflow",
              "prompt",
              "automation"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "behavior",
          "mitigation"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
