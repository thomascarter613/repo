{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/01_global_context.schema.json",
  "title": "Global Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "project",
    "mission",
    "rules",
    "canonical_locations",
    "session_contract",
    "naming"
  ],
  "properties": {
    "kind": {
      "const": "global_context"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code_name",
        "repository_role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_]{1,63}$"
        },
        "repository_role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonical_locations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_source",
        "compiled_context",
        "compiler",
        "initializer",
        "workflow"
      ],
      "properties": {
        "memory_source": {
          "type": "string",
          "minLength": 1
        },
        "compiled_context": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "initializer": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_reads",
        "checkpoint_updates",
        "handoff_updates",
        "required_output"
      ],
      "properties": {
        "bootstrap_reads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkpoint_updates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff_updates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_output": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id_regex",
        "decision_id_regex",
        "risk_id_regex",
        "blocker_id_regex",
        "branch_hint_pattern"
      ],
      "properties": {
        "task_id_regex": {
          "type": "string",
          "minLength": 1
        },
        "decision_id_regex": {
          "type": "string",
          "minLength": 1
        },
        "risk_id_regex": {
          "type": "string",
          "minLength": 1
        },
        "blocker_id_regex": {
          "type": "string",
          "minLength": 1
        },
        "branch_hint_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
