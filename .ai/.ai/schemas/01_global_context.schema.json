{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/01_global_context.schema.json",
  "title": "Global Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "project",
    "mission",
    "rules",
    "canonical_locations",
    "session_contract",
    "naming"
  ],
  "properties": {
    "kind": {
      "const": "global_context"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code_name", "repository_role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "code_name": {"type": "string", "minLength": 1},
        "repository_role": {"type": "string", "minLength": 1}
      }
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "canonical_locations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_source", "compiled_context", "compiler", "workflow"],
      "properties": {
        "memory_source": {"type": "string", "minLength": 1},
        "compiled_context": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1}
      }
    },
    "session_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_reads", "checkpoint_updates", "handoff_updates", "required_output"],
      "properties": {
        "bootstrap_reads": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "checkpoint_updates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "handoff_updates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_output": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id_pattern", "decision_id_pattern", "branch_hint_pattern"],
      "properties": {
        "task_id_pattern": {"type": "string", "pattern": "^\\^TASK-\\[0-9\\]\\{3,\\}\\$$"},
        "decision_id_pattern": {"type": "string", "pattern": "^\\^ADR-\\[0-9\\]\\{3,\\}\\$$"},
        "branch_hint_pattern": {"type": "string", "minLength": 1}
      }
    }
  }
}
