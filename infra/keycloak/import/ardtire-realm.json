    {
      "clientId": "ardtire-gov-api",
      "name": "Ardtire Governance API",
      "description": "Canonical governance API and policy enforcement service.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
